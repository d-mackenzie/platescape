<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TeethInc.Chantry.App.MainWindow"
        xmlns:pages="clr-namespace:TeethInc.Chantry.App.Pages"
        xmlns:viewmodels="clr-namespace:TeethInc.Chantry.App.ViewModels"
        Title="Chantry.App">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0">

            <TabItem Header="Source" FontSize="12" Padding="5">
                <pages:SourceImagePage DataContext="{Binding}"/>
            </TabItem>

            <TabItem Header="Filtered" FontSize="12" Padding="5">
            </TabItem>

            <TabItem Header="Mosaic" FontSize="12" Padding="5">
            </TabItem>

            <TabItem Header="Edits" FontSize="12" Padding="5">
            </TabItem>

        </TabControl>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="LightGray" />

        <TabControl Grid.Column="2">

            <TabItem Header="Source" FontSize="12" Padding="5">
                <pages:SourcePage DataContext="{Binding FileSourceViewModel}"/>
            </TabItem>
            
            <TabItem Header="Filters" FontSize="12" Padding="5">
            </TabItem>
            
            <TabItem Header="Mosaic" FontSize="12" Padding="5">
            </TabItem>
            
            <TabItem Header="Edits" FontSize="12" Padding="5">
            </TabItem>

        </TabControl>

    </Grid>
    
</Window>
