<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TeethInc.Chantry.App.Views.SplashView"
        Title="Chantry"
        MinWidth="800"
        MinHeight="400"
        MaxWidth="800"
        MaxHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush Source="/Assets/splash.png" Opacity="0.5"/>
    </Window.Background>
    
    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="48"
                   Padding="10"
                   Text="Chantry">
            <TextBlock.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </TextBlock.Background>
        </TextBlock>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">

                <Button Content="Create a new Project"
                        FontSize="24"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CreateANewProject}">
                    <Button.Background>
                        <SolidColorBrush Color="White" Opacity="0.5"/>
                    </Button.Background>
                </Button>

                <Button Content="Open an existing Project"
                        FontSize="24"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenAnExistingProject}">
                    <Button.Background>
                        <SolidColorBrush Color="White" Opacity="0.5"/>
                    </Button.Background>
                </Button>

            </StackPanel>
            
            <ListBox Grid.Column="1"
                       Margin="0,10,10,10">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.5"/>
                </ListBox.Background>
                MRU
            </ListBox>
            

        </Grid>

    </Grid>    
</Window>
