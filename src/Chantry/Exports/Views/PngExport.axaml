<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.Exports.Views.PngExport">

	<StackPanel>
		
		<Label Content="Pixels Per Stud:"/>
		<TextBox Text="{Binding PixelsPerStud}"/>
		
		<CheckBox Content="Draw Studs"
				  IsChecked="{Binding DrawStuds}"/>

		<CheckBox Content="Draw Outlines"
				  IsChecked="{Binding DrawOutlines}"/>

	</StackPanel>
	
</UserControl>
