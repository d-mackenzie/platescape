<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="TeethInc.Chantry.Views.Panels.FiltersView"
			 xmlns:viewmodels="clr-namespace:TeethInc.Chantry.Filters.ViewModels"
			 xmlns:viewmodels2="clr-namespace:TeethInc.Chantry.ViewModels"
			 xmlns:views="clr-namespace:TeethInc.Chantry.Filters.Views"
			 xmlns:filters="clr-namespace:TeethInc.Chantry.Core.Filters;assembly=Chantry.Core"
			 x:DataType="viewmodels2:ProjectViewModel">

<UserControl.Resources>
	<MenuFlyout x:Key="AddFilterMenu">
		<MenuItem Header="Brightness and Contrast"
					Command="{Binding AddNewBrightnessContrastFilterCommand}"/>
		<MenuItem Header="Multiply"
					Command="{Binding AddNewMultiplyFilterCommand}"/>
		<MenuItem Header="Saturation"
					Command="{Binding AddNewSaturationFilterCommand}"/>
	</MenuFlyout>
</UserControl.Resources>
	
	<ScrollViewer AllowAutoHide="False">

		<StackPanel>

			<ItemsControl ItemsSource="{Binding FilterViewModels}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*">
							<ToggleSwitch IsChecked="{Binding Enabled}"
											OnContent=""
											OffContent=""
											Grid.Column="0"
											Grid.Row="0"/>
							<Label Content="{Binding DisplayName}"
									VerticalContentAlignment="Center"
									FontWeight="Bold"
									Grid.Column="1"
									Grid.Row="0"/>
							<Button Grid.Column="2"
									Command="{Binding $parent[UserControl].((viewmodels2:ProjectViewModel)DataContext).RemoveFilterCommand}"
									CommandParameter="{Binding}"
									Grid.Row="0">
								<Button.Content>
									<Svg Path="/Assets/delete_FILL0_wght300_GRAD0_opsz24.svg"
										 Width="24"
										 Height="24"/>
								</Button.Content>
							</Button>
							<ContentControl Content="{Binding}"
											Grid.Row="1"
											Grid.Column="1"
											Grid.ColumnSpan="2">
								<ContentControl.DataTemplates>
									<DataTemplate DataType="{x:Type viewmodels:BrightnessContrastViewModel}">
										<views:BrightnessContrastView DataContext="{Binding}"/>
									</DataTemplate>
									<DataTemplate DataType="{x:Type viewmodels:SaturationViewModel}">
										<views:SaturationView DataContext="{Binding}"/>
									</DataTemplate>
									<DataTemplate DataType="{x:Type viewmodels:MultiplyViewModel}">
										<views:MultiplyView DataContext="{Binding}"/>
									</DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Button HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center"
					Flyout="{StaticResource AddFilterMenu}">
				<StackPanel Orientation="Horizontal">
					<Svg Path="/Assets/add_circle_FILL0_wght300_GRAD0_opsz24.svg"
						 Width="32"
						 Height="32"/>
					<Label Content="Add a filter..."
						   VerticalContentAlignment="Center"/>
				</StackPanel>
			</Button>

		</StackPanel>

	</ScrollViewer>
		
</UserControl>
