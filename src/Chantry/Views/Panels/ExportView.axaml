<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:views="clr-namespace:TeethInc.Chantry.Exports.Views"
			 x:Class="TeethInc.Chantry.Views.Panels.ExportView">

	<StackPanel>

		<Expander VerticalAlignment="Top" HorizontalAlignment="Stretch" IsExpanded="False">
			<Expander.Header>PNG</Expander.Header>
			<StackPanel>
				<views:ExportSettings DataContext="{Binding PngExportSettings}"/>
				<views:ExportButton DataContext="{Binding PngExportSettings}"/>
			</StackPanel>
		</Expander>

		<Expander VerticalAlignment="Top" HorizontalAlignment="Stretch" IsExpanded="False">
			<Expander.Header>LDraw</Expander.Header>
			<TextBlock>Todo</TextBlock>
		</Expander>

	</StackPanel>

</UserControl>
