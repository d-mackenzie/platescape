<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:exports="clr-namespace:TeethInc.Chantry.Views.Exports"
			 x:Class="TeethInc.Chantry.Views.Panels.ExportView">

	<StackPanel>

		<Expander VerticalAlignment="Top" HorizontalAlignment="Stretch" IsExpanded="False">
			<Expander.Header>PNG</Expander.Header>
			<TextBlock>Blah</TextBlock>
		</Expander>

		<Expander VerticalAlignment="Top" HorizontalAlignment="Stretch" IsExpanded="False">
			<Expander.Header>LDRAW</Expander.Header>
			<TextBlock>Blah</TextBlock>
		</Expander>

	</StackPanel>

</UserControl>
