<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:i="using:Avalonia.Xaml.Interactivity"		
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.Views.Panels.MosaicPropertiesView"
			 xmlns:local="clr-namespace:TeethInc.Chantry"
             xmlns:converters="clr-namespace:TeethInc.Chantry.Converters"
			 xmlns:usercontrols="clr-namespace:TeethInc.Chantry.UserControls"
 			 xmlns:viewmodels="clr-namespace:TeethInc.Chantry.ViewModels"
			 x:DataType="viewmodels:ProjectViewModel">

	<UserControl.Resources>
		<converters:SKSizeIToStringConverter x:Key="SKSizeIToStringConverter"/>
	</UserControl.Resources>

    <StackPanel>

		<StackPanel Orientation="Horizontal">
		
			<StackPanel>

				<Label Content="Baseplate:"/>

				<ComboBox ItemsSource="{Binding BaseplateSizes}"
							SelectedItem="{Binding BaseplateSize}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource SKSizeIToStringConverter}}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

			</StackPanel>

			<StackPanel Margin="10,0,0,0">
		
				<Label Content="Element:"/>

				<ComboBox ItemsSource="{Binding ElementSizes}"
							SelectedItem="{Binding ElementSize}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource SKSizeIToStringConverter}}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

			</StackPanel>
			
			<StackPanel Margin="10,0,0,0">

				<Label Content="Dither Mode:"/>

				<ComboBox ItemsSource="{Binding MosaicAlgorithms}"
							SelectedItem="{Binding MosaicAlgorithm}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

			</StackPanel>
		
		</StackPanel>
		
		<Grid RowDefinitions="Auto"
			  ColumnDefinitions="*,*"
			  Margin="0,10,0,0">

			<StackPanel	Grid.Row="0"
						Grid.Column="0"
						Margin="0,0,5,0">

				<StackPanel Orientation="Horizontal">
					<Label Content="Baseplates Wide:"/>
					<Label Content="{Binding BaseplateExtentWidth}"/>
				</StackPanel>

				<Slider Value="{Binding BaseplateExtentWidth}"
						IsSnapToTickEnabled="True"
						TickFrequency="1"
						TickPlacement="TopLeft"
						Minimum="1"
						Maximum="20"/>

			</StackPanel>

			<StackPanel	Grid.Row="0"
						Grid.Column="1"
						Margin="5,0,0,0">

				<StackPanel Orientation="Horizontal">
					<Label Content="Baseplates High:"/>
					<Label Content="{Binding BaseplateExtentHeight}"/>
				</StackPanel>

				<Slider Value="{Binding BaseplateExtentHeight}"
						IsSnapToTickEnabled="True"
						TickFrequency="1"
						TickPlacement="TopLeft"
						Minimum="1"
						Maximum="20"/>

			</StackPanel>
							
		</Grid>

		<Label Content="Allowed Colours:"/>

		<ListBox MaxHeight="400"
					ItemsSource="{Binding AllowedColors}"
					Margin="0,0,5,0"
					Background="Transparent">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Padding"
							Value="2"/>
				</Style>
			</ListBox.Styles>
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>						
					<usercontrols:ColorChip />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
				
    </StackPanel>
    
</UserControl>
