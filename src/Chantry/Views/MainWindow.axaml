<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:views="clr-namespace:TeethInc.Chantry.Views"
        xmlns:viewmodels="clr-namespace:TeethInc.Chantry.ViewModels"
		x:DataType="viewmodels:MainWindowViewModel"
        x:Class="TeethInc.Chantry.Views.MainWindow"
        Title="{Binding WindowTitle}"
		Icon="/Assets/app.ico"
        MinWidth="800"
        MinHeight="600">

    <DockPanel>

        <Grid DockPanel.Dock="Bottom"
              IsVisible="{Binding !IsLoading}">

            <views:ProjectView DataContext="{Binding ProjectViewModel}"
                            IsVisible="{Binding $parent.((viewmodels:MainWindowViewModel)DataContext).ProjectViewModel, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        
            <views:SplashView DataContext="{Binding SplashViewModel}"
                              IsVisible="{Binding $parent.((viewmodels:MainWindowViewModel)DataContext).ProjectViewModel, Converter={x:Static ObjectConverters.IsNull}}"/>
        
        </Grid>

    </DockPanel>
    
</Window>
