<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:views="clr-namespace:TeethInc.Chantry.Views"
        xmlns:viewmodels="clr-namespace:TeethInc.Chantry.ViewModels"
		x:DataType="viewmodels:MainWindowViewModel"
        x:Class="TeethInc.Chantry.Views.MainWindow"
        Title="{Binding WindowTitle}"
		Icon="/Assets/app.ico"
        MinWidth="800"
        MinHeight="600">

	<TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding Path=SelectedTab, Mode=TwoWay}">
	
		<TabControl.ItemTemplate>
			<DataTemplate>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
					<TextBlock Text="{Binding Header}" />
					<Button Content="X" />
				</StackPanel>
			</DataTemplate>
		</TabControl.ItemTemplate>	
		<TabControl.DataTemplates>
			<DataTemplate DataType="{x:Type viewmodels:SplashViewModel}">
				<views:SplashView DataContext="{Binding}"/>
			</DataTemplate>
			<DataTemplate DataType="{x:Type viewmodels:ProjectViewModel}">
				<views:ProjectView DataContext="{Binding}"/>
			</DataTemplate>
		</TabControl.DataTemplates>
	</TabControl>
	
</Window>
