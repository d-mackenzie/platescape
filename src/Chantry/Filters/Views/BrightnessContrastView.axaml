<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
 			 xmlns:viewmodels="clr-namespace:TeethInc.Chantry.Filters.ViewModels"
			 x:DataType="viewmodels:BrightnessContrastViewModel"
             x:Class="TeethInc.Chantry.Filters.Views.BrightnessContrastView">

    <StackPanel>
		
		<Grid RowDefinitions="Auto"
			  ColumnDefinitions="*,*">
		
			<StackPanel Grid.Row="0"
						Grid.Column="0"
						Margin="0,0,5,0">
				
				<StackPanel Orientation="Horizontal">				
					<Label Content="Brightness:"/>
					<Label Content="{Binding Brightness}"/>
				</StackPanel>
					
				<Slider Minimum="-100"
						Maximum="100"
						TickFrequency="10"
						TickPlacement="TopLeft"
						IsSnapToTickEnabled="True"
						Value="{Binding Brightness}"/>
			</StackPanel>

			<StackPanel Grid.Row="0"
						Grid.Column="1"
						Margin="5,0,0,0">

				<StackPanel Orientation="Horizontal">
					<Label Content="Contrast:"/>
					<Label Content="{Binding Contrast}"/>
				</StackPanel>

				<Slider Minimum="-100"
                Maximum="100"
                TickFrequency="10"
                TickPlacement="TopLeft"
				IsSnapToTickEnabled="True"
                Value="{Binding Contrast}"/>
				
			</StackPanel>
			
		</Grid>

    </StackPanel>
    
</UserControl>
