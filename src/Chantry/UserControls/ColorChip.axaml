<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:converters="clr-namespace:TeethInc.Chantry.Converters"
             x:Class="TeethInc.Chantry.UserControls.ColorChip">

	<UserControl.Resources>
		<converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
		<converters:ColorToContrastBrushConverter x:Key="ColorToContrastBrushConverter"/>
	</UserControl.Resources>
	
	<ToggleButton Content="{Binding LdColor.Name}"
				  IsChecked="{Binding IsSelected}"
				  BorderBrush="{Binding LdColor.Color, Converter={StaticResource ColorToBrushConverter}}">

		<ToggleButton.Styles>
			<Style Selector="ToggleButton:unchecked">
				<Setter Property="Background" Value="White"/>
				<Setter Property="Foreground" Value="{Binding LdColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
			</Style>
			<Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="{Binding $parent.DataContext.LdColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
				<Setter Property="Foreground" Value="{Binding $parent.DataContext.LdColor.Color, Converter={StaticResource ColorToContrastBrushConverter}}"/>
			</Style>
		</ToggleButton.Styles>
		
	</ToggleButton>
				  
</UserControl>
