<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:i="using:Avalonia.Xaml.Interactivity"		
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.PropertyPages.MosaicProperties"
			 xmlns:local="clr-namespace:TeethInc.Chantry"
             xmlns:converters="clr-namespace:TeethInc.Chantry.Converters">

    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
		<converters:BoolToBoldConverter x:Key="BoolToBoldConverter"/>
	</UserControl.Resources>
    
    <ScrollViewer AllowAutoHide="False">

        <StackPanel>

			<Grid RowDefinitions="Auto,Auto,Auto,Auto, Auto"
				  ColumnDefinitions="Auto,*">

				<Label Content="Algorithm:"
					   Grid.Row="0"
					   Grid.Column="0"
					   VerticalAlignment="Center"/>

				<ComboBox Items="{Binding MosaicAlgorithms}"
						  SelectedItem="{Binding MosaicAlgorithm}"
						  Grid.Row="0"
						  Grid.Column="1"
						  Margin="5">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Label Content="Size:"
					   Grid.Row="1"
					   Grid.Column="0"
					   VerticalAlignment="Center"/>

				<StackPanel Orientation="Horizontal"
							Grid.Row="1"
							Grid.Column="1"
							Margin="5">

					<NumericUpDown Minimum="1"
								   Maximum="20"
								   Value="{Binding BaseplateExtentWidth}" />

					<Label Content=" by "
						   VerticalAlignment="Center"/>

					<NumericUpDown Minimum="1"
								   Maximum="20"
								   Value="{Binding BaseplateExtentHeight}" />
				</StackPanel>

				<Label Content="Baseplate:"
					   Grid.Row="2"
					   Grid.Column="0"
					   VerticalAlignment="Center"/>
				
				<ComboBox Items="{Binding Baseplates}"
						  SelectedItem="{Binding Baseplate}"
						  Grid.Row="2"
						  Grid.Column="1"
						  Margin="5">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Label Content="Element:"
					   Grid.Row="3"
					   Grid.Column="0"
					   VerticalAlignment="Center"/>
				
				<ComboBox Items="{Binding Elements}"
						  SelectedItem="{Binding Element}"
						  Grid.Row="3"
						  Grid.Column="1"
						  Margin="5">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				
				<Label Content="Measurements:"
					   Grid.Row="4"
					   Grid.Column="0"/>

				<Label Content="{Binding SizeInfo}"
					   Grid.Row="4"
					   Grid.Column="1"/>
				
			</Grid>

			<Label Content="Colours:"/>

			<ListBox MaxHeight="400"
						Items="{Binding Colors}"
						Margin="0,0,5,0"
						Background="Transparent">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding"
								Value="2"/>
					</Style>
				</ListBox.Styles>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="25"
							  RowDefinitions="25"
							  Background="Transparent">

							<i:Interaction.Behaviors>
								<ia:EventTriggerBehavior EventName="PointerReleased">
									<ia:InvokeCommandAction Command="{Binding $parent[ListBox].DataContext.ToggleColorCommand}"
															CommandParameter="{Binding}"/>
								</ia:EventTriggerBehavior>
							</i:Interaction.Behaviors>

							<Rectangle Width="25"
										Height="25"
										Stroke="Black"
										StrokeThickness="1"
										Fill="{Binding LdColor.Color, Converter={StaticResource ColorToBrushConverter}}"
									    Grid.Column="0"
									    Grid.Row="0"
									    VerticalAlignment="Center">
							</Rectangle>
							
							<Path Data="M 5 8 L 10 13 L 21 0"
								  Stroke="{Binding TickColor, Converter={StaticResource ColorToBrushConverter}}"
								  StrokeThickness="3"
								  Grid.Column="0"
								  Grid.Row="0"
								  VerticalAlignment="Center"
								  IsVisible="{Binding IsAllowed}"/>
							
							<!--<TextBlock Text="{Binding LdColor.Name}"
									   Grid.Column="1"
									   Grid.Row="0"
									   Padding="5,0,0,0"
									   FontWeight="{Binding IsAllowed, Converter={StaticResource BoolToBoldConverter}}"/>-->
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
				
            <Button Content="Export LDRAW" Command="{Binding ExportLdraw}"/>

        </StackPanel>

    </ScrollViewer>
    
</UserControl>
