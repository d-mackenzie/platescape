<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.PropertyPages.FiltersPage"
             xmlns:viewmodels="clr-namespace:TeethInc.Chantry.Filters.ViewModels"
             xmlns:views="clr-namespace:TeethInc.Chantry.Filters.Views">

    <ItemsControl Items="{Binding Filters}">
        <ItemsControl.DataTemplates>
			<DataTemplate DataType="{x:Type viewmodels:BrightnessContrastViewModel}">
				<views:BrightnessContrastView DataContext="{Binding}"/>
            </DataTemplate>
			<DataTemplate DataType="{x:Type viewmodels:SaturationViewModel}">
				<views:SaturationView DataContext="{Binding}"/>
			</DataTemplate>
		</ItemsControl.DataTemplates>
    </ItemsControl>
        
</UserControl>
