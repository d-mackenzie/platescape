<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.Pages.FilteredImagePage"
 			 xmlns:usercontrols="clr-namespace:TeethInc.Chantry.UserControls">
		
	<usercontrols:ImageViewer Source="{Binding FilteredImage}"
							  Pan="{Binding Path=Pan, Mode=TwoWay}"
							  Zoom="{Binding Path=Zoom, Mode=TwoWay}"
							  ZoomMultiplier="{Binding ZoomMultiplier}"/>
	
</UserControl>
