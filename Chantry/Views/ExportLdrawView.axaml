<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
		xmlns:usercontrols="clr-namespace:TeethInc.Chantry.UserControls"
		x:Class="TeethInc.Chantry.Views.ExportLdrawView"
        Title="Export LDRAW"
		Icon="/Assets/app.ico"
		Width="600"
		MinHeight="450"
		MaxHeight="450">

	<Grid Margin="20 0 20 20">
		
		<Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>	
            <RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Label Grid.Row="0"
			   Content="Export LDRAW"
			   FontSize="24"/>
		
		<StackPanel Grid.Row="1">		
			<usercontrols:ExportSettingsControl DataContext="{Binding ExportSettingsViewModel}"/>
		</StackPanel>

		<Button Content="Export"
				IsEnabled="{Binding ExportSettingsViewModel.IsValid}"
				Command="{Binding ExportCommand}"
				Grid.Row="2"/>

	</Grid>

</Window>
