<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeethInc.Chantry.Views.SplashView">

    <UserControl.Background>
        <ImageBrush Stretch="UniformToFill" Source="/Assets/splash.jpg" Opacity="0.66"/>
    </UserControl.Background>

    <Grid>

        <Grid Margin="50" Background="White" Opacity="0.75">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontSize="36"
                       Padding="20"
                       Text="{Binding ApplicationTitle}"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="20 0 0 0">

                    <Button Content="Open an Image"
                            FontSize="24"
                            Margin="0 0 0 10"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenAnImageCommand}"/>

                    <Button Content="Open an existing Project"
                            FontSize="24"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenAProjectCommand}"/>

                </StackPanel>

                <ListBox Grid.Column="1"
                         Margin="0,10,10,10"
						 Items="{Binding Mru}">
                    <ListBox.Background>
                        <SolidColorBrush Color="Transparent"/>
                    </ListBox.Background>
                </ListBox>

            </Grid>
            
        </Grid>
        
    </Grid>
    
</UserControl>
