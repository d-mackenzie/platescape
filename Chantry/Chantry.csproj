<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>TeethInc.Chantry.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="0.10.11" />
    <PackageReference Include="Avalonia.Desktop" Version="0.10.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="0.10.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
   </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chantry.Core\Chantry.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="PropertyPages\ProjectPage.axaml.cs">
      <DependentUpon>ProjectPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\FilteredImagePage.axaml.cs">
      <DependentUpon>FilteredImagePage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\UnfilteredImagePage.axaml.cs">
      <DependentUpon>UnfilteredImagePage.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="SplashView.axaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SplashView.axaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\splash.jpg" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
